  "ipcRules": [
    {
      "name": "instance-source",
      "rule": "Use explicit --instance first, then TUCKMARK_DEVD_INSTANCE; absence is an error."
    },
    {
      "name": "instance-format",
      "rule": "Normalize to lowercase; require 1-48 lowercase ASCII letters, digits, or hyphens; first and last characters are alphanumeric."
    },
    {
      "name": "unix-address",
      "rule": "On macOS/Linux, use XDG_RUNTIME_DIR or the OS temp directory and a per-user, per-instance SHA-256-derived t-<12 hex> Unix socket."
    },
    {
      "name": "windows-address",
      "rule": "On Windows, use \\\\.\\pipe\\tuckmark-<user token>-<instance>."
    },
    {
      "name": "permissions",
      "rule": "Unix socket and endpoint lock are owner-only mode 0600; a newly created endpoint directory is mode 0700."
    },
    {
      "name": "ownership",
      "rule": "One listener owns an instance. Live owners reject a second listener; stale Unix sockets and stale PID locks are recoverable."
    },
    {
      "name": "protocol",
      "rule": "Send HTTP semantics over the named endpoint with x-tuckmark-ipc: 1, accept application/json, JSON request bodies, and JSON responses."
    },
    { "name": "method-default", "rule": "Default to GET without a body and POST with a body." },
    {
      "name": "errors",
      "rule": "Connection, timeout, invalid JSON, and non-2xx responses are errors; non-2xx JSON preserves status, code, revision fields, and message."
    },
    {
      "name": "authority",
      "rule": "HTTP and IPC listeners in one DEVD process share the same service and active data-directory authority."
    }
  ],
