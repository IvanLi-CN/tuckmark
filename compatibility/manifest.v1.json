  "httpBehavior": {
    "routeAccounting": "47 explicit API/health handlers plus CORS preflight, static asset GET, and SPA fallback GET form the 50-route observable contract.",
    "binding": "HTTP listens on 127.0.0.1 by default; /api/data and /api/agent-import reject non-loopback peers, non-loopback Host values, and non-local Origin values with 403.",
    "jsonError": { "status": "error", "error": "message" },
    "dataErrors": {
      "400": "validation_error or operation error",
      "403": "transport/origin rejection",
      "404": "not_found",
      "409": "revision_conflict with expectedRevision and actualRevision",
      "503": "data_unavailable"
    }
  },
