{
  "name": "tuckmark",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*",
    "apps/*",
    "plugins/*"
  ],
  "scripts": {
    "build": "bun run build:packages && bun run build:web",
    "build:packages": "bun run --filter @tuckmark/core build && bun run --filter @tuckmark/mcp build && bun run --filter @tuckmark/inventory build",
    "build:web": "bun run --filter @tuckmark/web build",
    "build:web:pages": "bun run --filter @tuckmark/web build:pages",
    "check": "bun run lint && bun run format:check && bun run typecheck && bun run test && bun run build",
    "dev:cli": "cargo run --locked --package tuckmark-cli --",
    "dev:mcp": "bun run --filter @tuckmark/mcp dev",
    "dev:data:prepare": "bun run scripts/dev-data-prepare.ts",
    "dev:preview": "bun run scripts/dev-preview.ts",
    "dev:server": "cargo run --locked --package tuckmark-devd -- serve",
    "dev:storybook": "bun run --filter @tuckmark/web storybook",
    "dev:web": "bun run --filter @tuckmark/web dev",
    "practice:agent-templates": "node scripts/agent-template-practice-report.mjs",
    "preview:web:pages": "bun scripts/serve-pages-preview.ts --root apps/web/dist --base / --port 4173",
    "format": "bun scripts/run-biome.ts write",
    "format:check": "bun scripts/run-biome.ts check",
    "lint": "bun scripts/run-biome.ts lint",
    "prepare": "lefthook install",
    "setup": "bun run scripts/setup.ts",
    "test": "bun run test:native && bun run test:contracts && bun run test:packages && bun run test:dev-scripts && bun run test:web",
    "test:native": "cargo test --workspace --locked",
    "test:contracts": "node scripts/check-compatibility-contract.mjs",
    "test:dev-scripts": "vitest run scripts/*.test.ts",
    "test:e2e:web": "bun run --filter @tuckmark/web test:e2e",
    "test:packages": "bun run --filter @tuckmark/core test && bun run --filter @tuckmark/mcp test && bun run --filter @tuckmark/inventory test",
    "test:web": "bun run --filter @tuckmark/web test",
    "test:worktree-bootstrap": "bun run scripts/test-worktree-bootstrap.ts",
    "typecheck": "bun run typecheck:packages && bun run typecheck:web",
    "typecheck:packages": "bun run --filter @tuckmark/core typecheck && bun run --filter @tuckmark/mcp typecheck && bun run --filter @tuckmark/inventory typecheck",
    "typecheck:web": "bun run --filter @tuckmark/web typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@types/node": "^26.0.0",
    "bwip-js": "^4.11.2",
    "lefthook": "^2.1.9",
    "playwright": "^1.61.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
